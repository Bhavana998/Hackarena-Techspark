# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Database
DATABASE_URL=postgresql://user:pass@localhost/levels
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60

# ML Models
MODEL_PATH=./models
TRAIN_MODELS_ON_STARTUP=true

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Security
SECRET_KEY=your-secret-key-here
API_KEY=your-api-key-here